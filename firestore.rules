rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // USUARIOS
    // ==========================================
    // Cada usuario solamente puede consultar,
    // crear, editar o eliminar su propio perfil.
    match /usuarios/{userId} {

      allow create: if request.auth != null
                    && request.auth.uid == userId;

      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow update: if request.auth != null
                    && request.auth.uid == userId;

      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }


    // ==========================================
    // RESULTADOS ANTIGUOS
    // ==========================================
    // La dejamos temporalmente porque actualmente
    // todavía tienes resultados_bienestar.
    match /resultados_bienestar/{resultadoId} {

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;

      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;

      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }


    // ==========================================
    // IMC
    // ==========================================
    match /resultados_imc/{resultadoId} {

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;

      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;

      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }


    // ==========================================
    // CALORÍAS
    // ==========================================
    match /resultados_calorias/{resultadoId} {

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;

      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;

      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }


    // ==========================================
    // DASS-21
    // ==========================================
    match /resultados_dass21/{resultadoId} {

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;

      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;

      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }


    // ==========================================
    // INSOMNIO DE ATENAS
    // ==========================================
    match /resultados_ais/{resultadoId} {

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;

      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;

      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }


    // ==========================================
    // RIESGO CARDIOVASCULAR / CARDIOMETABÓLICO
    // ==========================================
    match /resultados_riesgo_cardiovascular/{resultadoId} {

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;

      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;

      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }
  }
}